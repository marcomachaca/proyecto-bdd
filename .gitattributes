# Comportamiento por defecto: Git detecta si es texto y normaliza
* text=auto

# ------------------------------------------------------------
# Forzar LF (Unix) en archivos que se ejecutan en Linux/Docker
# ------------------------------------------------------------
*.sh        text eol=lf
*.bash      text eol=lf
*.zsh       text eol=lf

# Docker: los scripts dentro de la imagen DEBEN tener LF
Dockerfile      text eol=lf
*.dockerfile    text eol=lf
docker-compose*.yml   text eol=lf
docker-compose*.yaml  text eol=lf
compose*.yml          text eol=lf
compose*.yaml         text eol=lf

# Configuración y código que se procesa en Linux
*.yml       text eol=lf
*.yaml      text eol=lf
*.sql       text eol=lf
*.py        text eol=lf
*.env       text eol=lf
.env.example text eol=lf
*.conf      text eol=lf
*.ini       text eol=lf
*.toml      text eol=lf

# Documentación (LF para que se vea igual en todos lados)
*.md        text eol=lf
*.txt       text eol=lf

# ------------------------------------------------------------
# Forzar CRLF solo en scripts de Windows (si los hay)
# ------------------------------------------------------------
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# ------------------------------------------------------------
# Archivos binarios: Git NO debe normalizarlos ni convertirlos
# ------------------------------------------------------------
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.svg       text eol=lf
*.pdf       binary
*.zip       binary
*.tar       binary
*.gz        binary
*.7z        binary
*.xlsx      binary
*.docx      binary
*.pptx      binary
*.jar       binary
*.war       binary

# ------------------------------------------------------------
# Exclusiones de exportación (git archive)
# ------------------------------------------------------------
.gitignore      export-ignore
.gitattributes  export-ignore
.github/        export-ignore
docs/           export-ignore