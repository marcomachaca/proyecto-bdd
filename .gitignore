# ============================================================
# Regla de oro: NO ignorar archivos que el proyecto necesita
# (init/*.sql, fragmentacion/*.sql, docker-compose.yml,
#  .env.example, README.md, docs/). Solo ignorar lo que se
# regenera o es local de cada máquina.
# ============================================================

# ------------------------------------------------------------
# 1. Variables de entorno y secretos
# ------------------------------------------------------------
.env
*.env
*.env.local
*.env.*.local
!.env.example

# ------------------------------------------------------------
# 2. Datos de PostgreSQL en Docker
# ------------------------------------------------------------
# Carpetas bind-mount (si alguien las usa en lugar de volúmenes nombrados)
data/
pgdata/
postgres-data/
*/data/
*/pgdata/
equipo*/data/

# Dumps y backups de BD (pesados, no se versionan)
*.dump
*.backup
*.bak
*.sql.gz
*.sql.bz2

# ------------------------------------------------------------
# 3. Python (equipos 4 y 5)
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# Entornos virtuales
venv/
.venv/
env/
ENV/
.conda/
.python-version

# Cachés de herramientas
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# Jupyter
.ipynb_checkpoints/

# Empaquetado
build/
dist/
*.egg-info/
.eggs/

# ------------------------------------------------------------
# 4. IDEs y editores
# ------------------------------------------------------------
# VS Code (solo configuraciones personales; settings.json compartido no se ignora)
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# JetBrains (DataGrip, PyCharm, IntelliJ)
.idea/
*.iml
*.ipr
*.iws

# Vim / Neovim
*.swp
*.swo
*~
.netrwhist

# Emacs
*~
\#*\#
.\#*

# ------------------------------------------------------------
# 5. Sistema operativo
# ------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

Thumbs.db
ehthumbs.db
Desktop.ini
desktop.ini

# ------------------------------------------------------------
# 6. Logs y temporales
# ------------------------------------------------------------
*.log
logs/
*.tmp
*.temp
*.cache

# ------------------------------------------------------------
# 7. Docker local
# ------------------------------------------------------------
# Overrides personales (puertos distintos, credenciales locales)
docker-compose.override.yml
docker-compose.override.yaml
compose.override.yml
compose.override.yaml

# Contexto de build local
.docker/

# ------------------------------------------------------------
# 8. Misceláneos
# ------------------------------------------------------------
# Archivos de Office abiertos (lock files)
~$*.docx
~$*.xlsx
~$*.pptx

# Node (por si alguien usa una herramienta que lo requiera)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Archivos comprimidos generados localmente
*.zip
*.tar
*.tar.gz
*.7z

# Excepciones: sí queremos .zip de diagramas si el equipo 1 los sube
!docs/diagramas/*.zip