# ============================================================
# Ejemplo de variables de entorno
# Uso: cp .env.example .env  y ajustar los valores
# NUNCA commitear el archivo .env con credenciales reales
# ============================================================

# --- Credenciales PostgreSQL (compartidas por los 6 nodos) ---
POSTGRES_USER=admin_bdd
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=boliviadistribucion

# --- Puertos locales (host) para cada nodo ---
# Nodo 1 - La Paz
NODO1_PORT=5431
# Nodo 2 - Santa Cruz
NODO2_PORT=5432
# Nodo 3 - Cochabamba
NODO3_PORT=5433
# Nodo 4 - Tarija
NODO4_PORT=5434
# Nodo 5 - Oruro
NODO5_PORT=5435
# Nodo 6 - Beni
NODO6_PORT=5436

# --- Red Docker compartida entre los nodos ---
BDD_NETWORK=bdd_net
